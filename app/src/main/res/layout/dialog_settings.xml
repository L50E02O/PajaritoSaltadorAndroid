<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@color/dialog_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@color/dialog_background">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_audio"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/dialog_text_primary"
            android:letterSpacing="0.02"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_music"
                android:textSize="16sp"
                android:textColor="@color/dialog_text_primary"
                android:contentDescription="@string/cd_settings_music" />

            <Switch
                android:id="@+id/switchMusic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:contentDescription="@string/cd_switch_music" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_music_hint"
            android:textSize="13sp"
            android:textColor="@color/dialog_text_secondary"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/cd_settings_music_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_sfx"
                android:textSize="16sp"
                android:textColor="@color/dialog_text_primary"
                android:contentDescription="@string/cd_settings_sfx" />

            <Switch
                android:id="@+id/switchSfx"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:contentDescription="@string/cd_switch_sfx" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_layout"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/dialog_text_primary"
            android:letterSpacing="0.02"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_power_bar_drag_explain"
            android:textSize="14sp"
            android:textColor="@color/dialog_text_primary"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_power_bar_drag_detail"
            android:textSize="13sp"
            android:textColor="@color/dialog_text_secondary"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_about"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/dialog_text_primary"
            android:letterSpacing="0.02"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/textVersionInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/dialog_text_secondary"
            android:fontFamily="monospace"
            android:paddingTop="4dp"
            android:contentDescription="@string/cd_settings_version" />

    </LinearLayout>
</ScrollView>
