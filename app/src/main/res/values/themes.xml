<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PajaritoSaltador" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Light fijo: DayNight con fondo blanco dejaba texto claro invisible en modo oscuro -->
    <style name="SettingsDialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorPrimary">@color/button_green</item>
        <item name="colorAccent">@color/teal_700</item>
        <item name="android:textColorPrimary">@color/dialog_text_primary</item>
        <item name="android:textColorSecondary">@color/dialog_text_secondary</item>
        <item name="android:windowBackground">@color/dialog_background</item>
    </style>
</resources>
