# Copia este archivo como keystore.properties en la raiz del proyecto y rellena los valores.
# keystore.properties no se sube a git (esta en .gitignore).
# storeFile es una ruta relativa a la raiz del proyecto (donde esta settings.gradle).

storeFile=pajarito-release.jks
storePassword=TU_CONTRASENA_DEL_KEYSTORE
keyAlias=pajarito
keyPassword=TU_CONTRASENA_DE_LA_CLAVE
